# Postgres (matches docker-compose.yml — port 5434, avoiding conflicts with
# any system Postgres on 5432 or another project's Docker Postgres on 5433)
DATABASE_URL="postgresql://imagematching:imagematching@localhost:5434/imagematching?schema=public"

# Gemini API key — get one free at aistudio.google.com, no credit card
GEMINI_API_KEY=

PORT=3000

# Hard spending cap for the vision/embedding batch job, in USD. The batch
# job stops gracefully once the running total would exceed this.
COST_BUDGET_USD=1.00